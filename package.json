{
  "name": "switchboard",
  "version": "0.3.0",
  "private": true,
  "description": "A desktop app for browsing, searching, and managing CLI coding sessions",
  "author": "Zakhar Morozov <fortael@yahoo.com",
  "main": "main.js",
  "scripts": {
    "start": "npm run bundle:codemirror && npm run bundle:vue && electron .",
    "test": "node --test",
    "electron": "npm run bundle:vue && electron .",
    "dev": "npm run bundle:codemirror && npm run bundle:vue && (vite build --watch & electron .) && wait",
    "bundle:codemirror": "esbuild public/codemirror-setup.js --bundle --outfile=public/codemirror-bundle.js --format=iife --platform=browser --minify",
    "bundle:vue": "vite build",
    "build:landing": "vite build --config vite.landing.config.js && cp build/icon.png docs/icon.png",
    "dev:landing": "node scripts/dev-landing.mjs",
    "preview:landing": "node scripts/serve-docs.mjs",
    "generate-icons": "node scripts/generate-icons.js && node scripts/generate-dmg-background.js",
    "build": "npm run bundle:codemirror && npm run bundle:vue && electron-builder",
    "build:mac": "npm run bundle:codemirror && npm run bundle:vue && electron-builder --mac && node scripts/postinstall.js && codesign --sign - --force --deep dist/mac-arm64/WootonPad.app 2>/dev/null; true",
    "build:mac:arm64": "npm run bundle:vue && electron-builder --mac --arm64 2>/dev/null; true",
    "build:win": "npm run bundle:codemirror && npm run bundle:vue && electron-builder --win",
    "build:linux": "npm run bundle:codemirror && npm run bundle:vue && electron-builder --linux",
    "release": "npm run bundle:codemirror && npm run bundle:vue && electron-builder --publish always",
    "postinstall": "node scripts/postinstall.js"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode-graphemes": "^0.4.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "better-sqlite3": "^12.11.1",
    "electron-log": "^5.3.0",
    "electron-updater": "^6.3.0",
    "marked": "^17.0.4",
    "morphdom": "^2.7.8",
    "node-pty": "^1.0.0",
    "ws": "^8.18.0"
  },
  "overrides": {
    "chokidar": "^4.0.0"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.10.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/merge": "^6.12.1",
    "@codemirror/search": "^6.6.0",
    "@codemirror/state": "^6.5.4",
    "@codemirror/view": "^6.39.16",
    "@ddietr/codemirror-themes": "^1.5.2",
    "@napi-rs/canvas": "^0.1.62",
    "@vitejs/plugin-vue": "^6.0.8",
    "codemirror": "^6.0.2",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "electron-reloader": "^1.2.3",
    "esbuild": "^0.28.1",
    "png2icons": "^2.0.1",
    "vite": "^8.1.5",
    "vue": "^3.5.40"
  },
  "build": {
    "appId": "ai.doctly.switchboard",
    "productName": "WootonPad",
    "files": [
      "*.js",
      "workers/**/*",
      "public/**/*",
      "node_modules/**/*",
      "!node_modules/better-sqlite3/deps/**",
      "!node_modules/better-sqlite3/src/**",
      "!node_modules/better-sqlite3/build/Release/obj/**",
      "!node_modules/better-sqlite3/build/Release/test_extension.node",
      "!node_modules/node-pty/src/**",
      "!node_modules/node-pty/build/Release/obj/**",
      "!node_modules/**/*.map",
      "!node_modules/**/*.ts",
      "!node_modules/**/test/**",
      "!node_modules/**/tests/**",
      "!node_modules/**/spec/**",
      "!node_modules/**/docs/**",
      "!node_modules/**/example/**",
      "!node_modules/**/examples/**",
      "!node_modules/**/.github/**",
      "!node_modules/**/*.md"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**",
      "node_modules/node-pty/**"
    ],
    "publish": {
      "provider": "github",
      "owner": "fortael",
      "repo": "wootonpad",
      "releaseType": "release"
    },
    "mac": {
      "protocols": [
        {
          "name": "WootonPad",
          "schemes": [
            "wootonpad"
          ]
        }
      ],
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "notarize": true
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development"
    },
    "dmg": {
      "background": "build/dmg-background.png",
      "iconSize": 100,
      "window": {
        "width": 660,
        "height": 400
      },
      "contents": [
        {
          "x": 170,
          "y": 170
        },
        {
          "x": 490,
          "y": 170,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
