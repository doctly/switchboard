{
  "name": "switchboard",
  "version": "0.0.29",
  "private": true,
  "description": "A desktop app for browsing, searching, and managing CLI coding sessions",
  "author": "Doctly <support@doctly.ai>",
  "main": "main.js",
  "scripts": {
    "start": "npm run bundle:codemirror && electron .",
    "test": "node --test",
    "electron": "electron .",
    "bundle:codemirror": "esbuild public/codemirror-setup.js --bundle --outfile=public/codemirror-bundle.js --format=iife --platform=browser --minify",
    "generate-icons": "node scripts/generate-icons.js && node scripts/generate-dmg-background.js",
    "apply-branding": "node scripts/apply-branding.js",
    "build": "npm run bundle:codemirror && npm run apply-branding && electron-builder --config electron-builder-config.json",
    "build:mac": "npm run bundle:codemirror && npm run apply-branding && electron-builder --mac --config electron-builder-config.json && node scripts/postinstall.js && node scripts/codesign-app.js 2>/dev/null; true",
    "build:mac:arm64": "npm run apply-branding && electron-builder --mac --arm64 --config electron-builder-config.json 2>/dev/null; true",
    "build:win": "npm run bundle:codemirror && npm run apply-branding && electron-builder --win --config electron-builder-config.json",
    "build:win:portable": "npm run bundle:codemirror && npm run apply-branding && electron-builder --win --dir --config electron-builder-config.json",
    "build:linux": "npm run bundle:codemirror && npm run apply-branding && electron-builder --linux --config electron-builder-config.json",
    "release": "npm run bundle:codemirror && npm run apply-branding && electron-builder --publish always --config electron-builder-config.json",
    "preinstall": "node scripts/preinstall-guard.js",
    "postinstall": "node scripts/postinstall.js"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-unicode-graphemes": "0.4.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "better-sqlite3": "12.8.0",
    "dompurify": "3.4.1",
    "electron-log": "5.4.3",
    "electron-updater": "6.3.9",
    "marked": "17.0.4",
    "morphdom": "2.7.8",
    "node-pty": "1.1.0",
    "ws": "8.19.0"
  },
  "devDependencies": {
    "@codemirror/commands": "6.10.2",
    "@codemirror/lang-markdown": "6.5.0",
    "@codemirror/language-data": "6.5.2",
    "@codemirror/merge": "6.12.1",
    "@codemirror/search": "6.6.0",
    "@codemirror/state": "6.5.4",
    "@codemirror/view": "6.39.16",
    "@ddietr/codemirror-themes": "1.5.2",
    "@napi-rs/canvas": "0.1.96",
    "codemirror": "6.0.2",
    "electron": "41.0.3",
    "electron-builder": "26.8.1",
    "electron-reloader": "1.2.3",
    "esbuild": "0.27.3",
    "png2icons": "2.0.1"
  },
  "build": {
    "appId": "ai.doctly.switchboard",
    "productName": "Switchboard",
    "files": [
      "*.js",
      "workers/**/*",
      "public/**/*",
      "node_modules/**/*"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**",
      "node_modules/node-pty/**"
    ],
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "buildDependenciesFromSource": false,
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "notarize": true
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development"
    },
    "dmg": {
      "background": "build/dmg-background.png",
      "iconSize": 100,
      "window": {
        "width": 660,
        "height": 400
      },
      "contents": [
        {
          "x": 170,
          "y": 170
        },
        {
          "x": 490,
          "y": 170,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
